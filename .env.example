# Copie este arquivo para .env e preencha as credenciais.
# Nunca publique o arquivo .env.
PORT=3000
# Em hospedagens com volume persistente, use por exemplo /data.
DATA_DIR=
# URL publica exata, sem caminho. Obrigatoria em hospedagem com proxy HTTPS.
APP_ORIGIN=http://localhost:3000
# Defina production no site hospedado para cookies Secure.
NODE_ENV=development
# Use 1 somente atras de um proxy confiavel que substitui X-Forwarded-For.
TRUST_PROXY=0
# Opcional: chave de 32 bytes em base64. Sem ela, uma chave e criada no DATA_DIR.
# Preserve a mesma chave e o volume entre deploys.
DATA_ENCRYPTION_KEY=

# Credenciais abaixo: apenas para importar uma instalacao antiga.
# Novas contas cadastram suas comunidades pela interface.
BROS_USERNAME=
BROS_PASSWORD=

CHIEFS_USERNAME=
CHIEFS_PASSWORD=

ALCATEIA_USERNAME=
ALCATEIA_PASSWORD=

NEXUS_USERNAME=
NEXUS_PASSWORD=

# Crie um aplicativo em https://dev.kick.com
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/kick/callback
# Use apenas escopos habilitados no cadastro do aplicativo da Kick.
# Acrescente apenas permissões que também estejam habilitadas no portal da Kick.
# Exemplo completo: user:read channel:read events:subscribe
KICK_SCOPES=user:read
