CHIEFS_PASSWORD=

PRINTSTREAM_USERNAME=
PRINTSTREAM_PASSWORD=

RIVALS_USERNAME=
RIVALS_PASSWORD=

ALCATEIA_USERNAME=
ALCATEIA_PASSWORD=

NEXUS_USERNAME=
NEXUS_PASSWORD=

# Crie um aplicativo em https://dev.kick.com
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/kick/callback
